# Byte-compiled / optimized / distributed packages
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
*.egg

# Compiled distributions
# dist/ is built fresh by CI (python -m build); never commit stale artifacts —
# old files left in dist/ get uploaded together with new ones and PyPI rejects them.
dist/

# Virtual environments
.env
.venv
env/
venv/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Testing
.pytest_cache/
.coverage
htmlcov/
*.cover

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json

# Pre-commit
.pre-commit-cache/

# OS
.DS_Store
Thumbs.db

# Credentials (never commit)
*.key
*.pem
.env.local
